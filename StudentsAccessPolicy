{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "StudentsPolicy",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::ijapo-schoolfile/*"
            ]
        },
        {
            "Sid": "ListBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::ijapo-schoolfile"
            ]
        }
    ]
}
